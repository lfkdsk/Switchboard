# Agent Box configuration. `run.sh` copies this to .env on first run.
# Everything here is optional — the defaults work out of the box.

# Which Switchboard relay to dial. Point this at your own if you self-host.
SWITCHBOARD_SERVER=https://shell.lfkdsk.org

# auto  → token mode (shareable URL), unless the box has been signed in
# token → always a shareable URL
# login → GitHub sign-in; the box shows up in your dashboard, only you can open it
SWITCHBOARD_MODE=auto

# Pin your own share token instead of the generated one (min 24 chars).
# Leave empty and the box mints one on first run and reuses it forever.
SWITCHBOARD_TOKEN=

# Set to `claude` to also report live Claude Code sessions to the dashboard
# (title, current tool, idle time — never prompts or message contents).
SWITCHBOARD_ACTIVITY=

# Skip the interactive logins with API keys instead. Careful: anyone with a shell
# in the box can read these, and sharing the URL is the point of the box.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Container/image names, if you want more than one box on the same host.
AGENTBOX_NAME=agentbox
AGENTBOX_IMAGE=agentbox:latest

# Pin tool versions for a reproducible build (default: latest at build time).
SWITCHBOARD_CLI_VERSION=latest
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest

