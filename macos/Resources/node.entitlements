<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- These apply to the embedded Node binary, not to Switchboard.app.
       DaemonSupervisor spawns runtime/bin/node as a child process, so the
       kernel reads that binary's own signature and entitlements, not the
       app's. Notarization requires the hardened runtime, and the hardened
       runtime blocks V8's JIT unless we ask for it back. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>

  <!-- node dlopens pty.node. We sign it with the same Team ID, but Node also
       resolves addon paths at runtime, and library validation is unforgiving
       about anything it did not expect. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
