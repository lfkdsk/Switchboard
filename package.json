{
  "name": "switchboard",
  "version": "1.0.0",
  "private": true,
  "description": "Switchboard — a self-hosted Cloudflare relay for the @elsetech/webterm daemon.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node --experimental-default-type=module --test tests/*.test.mjs",
    "test:mutation:account-sessions": "node tests/mutations/account-session-guards.mjs",
    "test:e2e:webshell": "node tests/e2e/webshell-reload.mjs && node tests/e2e/webshell-account-visibility.mjs"
  },
  "devDependencies": {
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "playwright-core": "^1.64.1",
    "wrangler": "^4.124.0"
  }
}
